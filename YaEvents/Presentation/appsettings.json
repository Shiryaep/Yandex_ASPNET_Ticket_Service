{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Error"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=mydatabase;Username=postgres;Include Error Detail=True",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Issuer": "MyApp",
    "Audience": "MyApp",
    "Lifetime": "30"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "ConsumerGroup": "events-service"
  },
  "Redis": {
    "EventsGetEventByIdTTLSeconds": "5",
    "EventsGetTopEventsTTLMinutes": "60"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  }
}
